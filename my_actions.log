2026-11-18T06:59:22.720786Z	   53 Query	USE orders_norm_lab5
2026-11-18T06:59:22.721061Z	   53 Query	CREATE TABLE customers (
    customer_id   INT          NOT NULL,
    customer_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (customer_id)
)
2026-11-18T06:59:22.758406Z	   53 Query	CREATE TABLE product_classes (
    class_id   INT          NOT NULL,
    class_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (class_id)
)
2026-11-18T06:59:22.795862Z	   53 Query	CREATE TABLE products (
    product_id   INT           NOT NULL,
    product_name VARCHAR(100)  NOT NULL,
    price        DECIMAL(10,2) NOT NULL,
    class_id     INT           NOT NULL,
    PRIMARY KEY (product_id),
    FOREIGN KEY (class_id) REFERENCES product_classes (class_id)
)
2026-11-18T06:59:22.840120Z	   53 Query	CREATE TABLE orders (
    order_id    INT  NOT NULL,
    order_date  DATE NOT NULL,
    customer_id INT  NOT NULL,
    PRIMARY KEY (order_id),
    FOREIGN KEY (customer_id) REFERENCES customers (customer_id)
)
2026-11-18T06:59:22.893845Z	   53 Query	CREATE TABLE order_items (
    order_id   INT NOT NULL,
    product_id INT NOT NULL,
    quantity   INT NOT NULL,
    PRIMARY KEY (order_id, product_id),
    FOREIGN KEY (order_id)   REFERENCES orders    (order_id),
    FOREIGN KEY (product_id) REFERENCES products (product_id)
)
